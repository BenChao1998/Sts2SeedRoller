<UserControl x:Class="SeedUi.Views.RunValidationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibilityConverter"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1" Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="#F7F9FC"/>
            <Setter Property="BorderBrush" Value="#DCE5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0 0 10 10"/>
        </Style>
        <Style x:Key="RunValidationCellTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RunValidationDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.SurfaceSubtle}"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style x:Key="RunValidationColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Brush.SurfaceSubtle}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="Padding" Value="10 9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="RunValidationRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="{StaticResource Brush.Surface}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.PrimaryMuted}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.PrimarySubtle}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.DangerMuted}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RunValidationCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10 7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0 0 0 16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="选择存档" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0 0 0 10"/>
                    <TextBox Text="{Binding RunValidationFilePath, UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             VerticalContentAlignment="Center"
                             TextWrapping="NoWrap"/>
                    <Grid Margin="0 10 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0 0 16 0">
                            <TextBlock Text="验证版本" FontSize="12" Foreground="#666" Margin="0 0 0 4"/>
                            <ComboBox ItemsSource="{Binding RunValidationVersionOptions}"
                                      SelectedItem="{Binding SelectedRunValidationVersionOption}"
                                      DisplayMemberPath="DisplayName"
                                      Height="30"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Content="只验证第一/二/三幕开始选项"
                                  IsChecked="{Binding RunValidationOpeningOptionsOnly}"
                                  VerticalAlignment="Bottom"
                                  Margin="0 0 0 6"/>
                    </Grid>
                    <TextBlock Text="{Binding RunValidationStatus}" FontSize="12" Foreground="#666" TextWrapping="Wrap" Margin="0 8 0 0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="选择文件"
                        Command="{Binding SelectRunValidationFileCommand}"
                        Style="{StaticResource ButtonDefault}"
                        Margin="16 26 8 0"
                        VerticalAlignment="Top"/>
                <Button Grid.Column="2"
                        Content="验证存档"
                        Command="{Binding ValidateRunArchiveCommand}"
                        Style="{StaticResource ButtonPrimary}"
                        Margin="0 26 0 0"
                        VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0 0 0 16"
                Visibility="{Binding HasRunValidationResult, Converter={StaticResource BooleanVisibilityConverter}}">
            <StackPanel DataContext="{Binding RunValidationResult}">
                <TextBlock Text="匹配度分析" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0 0 0 12"/>
                <WrapPanel>
                    <Border Style="{StaticResource MetricBlockStyle}" MinWidth="150">
                        <StackPanel>
                            <TextBlock Text="总匹配度" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding GeneratedSummary}" FontSize="22" FontWeight="SemiBold" Foreground="#1976D2"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricBlockStyle}" MinWidth="110">
                        <StackPanel>
                            <TextBlock Text="不匹配" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding GeneratedMismatches}" FontSize="22" FontWeight="SemiBold" Foreground="#D32F2F"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricBlockStyle}" MinWidth="110">
                        <StackPanel>
                            <TextBlock Text="卡牌" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding CardMatches}" FontSize="20" FontWeight="SemiBold" Foreground="#333"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricBlockStyle}" MinWidth="110">
                        <StackPanel>
                            <TextBlock Text="遗物" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding RelicMatches}" FontSize="20" FontWeight="SemiBold" Foreground="#333"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricBlockStyle}" MinWidth="110">
                        <StackPanel>
                            <TextBlock Text="商店遗物" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding ShopRelicMatches}" FontSize="20" FontWeight="SemiBold" Foreground="#333"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricBlockStyle}" MinWidth="110">
                        <StackPanel>
                            <TextBlock Text="商店药水" FontSize="12" Foreground="#666"/>
                            <TextBlock Text="{Binding ShopPotionMatches}" FontSize="20" FontWeight="SemiBold" Foreground="#333"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Grid Margin="0 4 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SeedText, StringFormat=种子：{0}}" FontSize="12" Foreground="#555"/>
                    <TextBlock Grid.Column="1" Text="{Binding CharacterId, StringFormat=角色：{0}}" FontSize="12" Foreground="#555"/>
                    <TextBlock Grid.Column="2" Text="{Binding Ascension, StringFormat=进阶：{0}}" FontSize="12" Foreground="#555"/>
                    <TextBlock Grid.Column="3" Text="{Binding Floors, StringFormat=楼层：{0}}" FontSize="12" Foreground="#555"/>
                </Grid>
                <Grid Margin="0 6 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding GameVersion, StringFormat=存档版本：{0}}" FontSize="12" Foreground="#777"/>
                    <TextBlock Grid.Column="1" Text="{Binding ValidationDataVersion, StringFormat=验证数据：{0}}" FontSize="12" Foreground="#777"/>
                    <TextBlock Grid.Column="2" Text="{Binding ValidationScope, StringFormat=范围：{0}}" FontSize="12" Foreground="#777"/>
                    <TextBlock Grid.Column="3" Text="{Binding FinalRelicMatchText, StringFormat=最终遗物：{0}}" FontSize="12" Foreground="#777"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Visibility="{Binding HasRunValidationResult, Converter={StaticResource BooleanVisibilityConverter}}">
            <Grid DataContext="{Binding RunValidationResult}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#333"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FileName}" FontSize="12" Foreground="#999" HorizontalAlignment="Right"/>
                </DockPanel>
                <DataGrid Grid.Row="1"
                          Style="{StaticResource RunValidationDataGridStyle}"
                          ItemsSource="{Binding VisibleRows}"
                          ColumnHeaderStyle="{StaticResource RunValidationColumnHeaderStyle}"
                          RowStyle="{StaticResource RunValidationRowStyle}"
                          CellStyle="{StaticResource RunValidationCellStyle}"
                          MinHeight="260"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="层" Width="48" Binding="{Binding Floor}" ElementStyle="{StaticResource RunValidationCellTextStyle}"/>
                        <DataGridTextColumn Header="房间" Width="64" Binding="{Binding RoomType}" ElementStyle="{StaticResource RunValidationCellTextStyle}"/>
                        <DataGridTextColumn Header="类型" Width="92" Binding="{Binding Category}" ElementStyle="{StaticResource RunValidationCellTextStyle}"/>
                        <DataGridTextColumn Header="状态" Width="82" Binding="{Binding MatchText}" ElementStyle="{StaticResource RunValidationCellTextStyle}"/>
                        <DataGridTextColumn Header="存档记录" Width="260" Binding="{Binding Expected}" ElementStyle="{StaticResource RunValidationCellTextStyle}"/>
                        <DataGridTextColumn Header="模拟生成" Width="260" Binding="{Binding Generated}" ElementStyle="{StaticResource RunValidationCellTextStyle}"/>
                        <DataGridTextColumn Header="说明" Width="*" MinWidth="260" Binding="{Binding Notes}" ElementStyle="{StaticResource RunValidationCellTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
