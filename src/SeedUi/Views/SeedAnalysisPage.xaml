<UserControl x:Class="SeedUi.Views.SeedAnalysisPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shapes="clr-namespace:System.Windows.Shapes;assembly=PresentationFramework"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1" Color="#000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
        </Style>

        <Style x:Key="EventNameStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="Margin" Value="0 2 0 2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#8A5A00"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EventTooltipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="#F6E6A9"/>
            <Setter Property="BorderBrush" Value="#B28B2E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#3E2B00"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Placement" Value="Mouse"/>
            <Setter Property="HasDropShadow" Value="True"/>
        </Style>

        <Style x:Key="RouteTabItemStyle" TargetType="TabItem">
            <Setter Property="Margin" Value="0 0 8 0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#F3F3F3"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="14 8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFF3CD"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#D9A441"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FAFAFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RouteTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="RouteSideCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#EDEDED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0 0 0 16">
            <StackPanel>
                <TextBlock Text="种子分析" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0 0 0 16"/>

                <Grid Margin="0 0 0 12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.95*"/>
                        <ColumnDefinition Width="0.95*"/>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="0.85*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0 0 12 0">
                        <TextBlock Text="种子" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <TextBox Text="{Binding SeedText, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0 0 12 0">
                        <TextBlock Text="版本" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <ComboBox ItemsSource="{Binding GameVersionOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedGameVersion}"
                                  MinHeight="25"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0 0 12 0">
                        <TextBlock Text="角色" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <ComboBox ItemsSource="{Binding CharacterOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedCharacter}"
                                  MinHeight="25"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0 0 12 0">
                        <TextBlock Text="进阶等级" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <ComboBox ItemsSource="{Binding AscensionOptions}"
                                  SelectedValue="{Binding SelectedAscensionLevel}"
                                  MinHeight="25"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0 0 12 0">
                        <TextBlock Text="概率采样次数" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <TextBox Text="{Binding VisibilitySampleCountText, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Margin="0 0 12 0">
                        <TextBlock Text="海玻璃采样次数" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <TextBox Text="{Binding SeaGlassSampleCountText, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                        <Button Content="分析"
                                Command="{Binding AnalyzeSeedCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                Padding="20 6"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding SelectedGameVersionStatusText}"
                           Foreground="#666"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0 0 0 6"/>
                <TextBlock Text="{Binding SeedAnalysisSummary}" Foreground="#333" TextWrapping="Wrap" Margin="0 0 0 4"/>
                <TextBlock Text="{Binding SeedAnalysisSeedValueText}" Foreground="#1976D2" FontSize="12"/>

                <Border Margin="0 12 0 0"
                        Padding="12"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="#D7CCC8"
                        Background="#FAFAFA">
                    <StackPanel>
                        <TextBlock Text="进度存档说明"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#333"
                                   Margin="0 0 0 8"/>
                        <TextBlock Text="{Binding ProgressSaveLoadStatus}" Foreground="#8A5A00" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ProgressSaveSummary}" Foreground="#666" TextWrapping="Wrap" Margin="0 6 0 0"/>
                        <TextBlock Text="{Binding ProgressSavePathText}" Foreground="#666" TextWrapping="Wrap" Margin="0 6 0 0"/>
                        <TextBlock Text="{Binding ProgressSaveEpochText}" Foreground="#666" TextWrapping="Wrap" Margin="0 6 0 0"/>
                        <TextBlock Text="{Binding ProgressSaveAncientRuleText}" Foreground="#666" TextWrapping="Wrap" Margin="0 6 0 0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0 0 0 16">
            <StackPanel>
                <TextBlock Text="开局选项信息" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0 0 0 12"/>
                <TextBlock Text="这里会展示第一幕 Neow 以及第二、第三幕古神的开局选项。"
                           Foreground="#666"
                           Margin="0 0 0 12"/>

                <ItemsControl ItemsSource="{Binding SeedAnalysisOpeningActs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding Title}" IsExpanded="True" Margin="0 0 0 12">
                                <StackPanel Margin="0 8 0 0">
                                    <TextBlock Text="{Binding AncientDisplay}"
                                               Foreground="#8A5A00"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasAncientDisplay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <ItemsControl ItemsSource="{Binding Options}" Margin="0 8 0 0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E3D39B"
                                                        BorderThickness="1"
                                                        Background="#FFF9E7"
                                                        CornerRadius="6"
                                                        Padding="10"
                                                        Margin="0 0 0 8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3E2B00" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   Margin="0 4 0 0"
                                                                   Foreground="#5A4300"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding Note}"
                                                                   Margin="0 6 0 0"
                                                                   Foreground="#8A5A00"
                                                                   TextWrapping="Wrap"
                                                                   Visibility="{Binding HasNote, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <ItemsControl ItemsSource="{Binding Details}"
                                                                      Margin="0 6 0 0"
                                                                      Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" Margin="0 2 0 0" Foreground="#444" TextWrapping="Wrap"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0 0 0 16">
            <StackPanel>
                <TextBlock Text="遗物概率预览" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0 0 0 12"/>
                <TextBlock Text="{Binding SeedAnalysisRelicVisibilitySummary}" Foreground="#666" TextWrapping="Wrap" Margin="0 0 0 12"/>

                <ItemsControl ItemsSource="{Binding SeedAnalysisRelicVisibilityProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpandedByDefault, Mode=OneWay}" Margin="0 0 0 12">
                                <StackPanel Margin="0 8 0 0">
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="#666"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <ItemsControl ItemsSource="{Binding ActSummaries}" Margin="0 8 0 0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Margin="0 2 0 2" Foreground="#555" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0 12 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0 0 12 0">
                                            <TextBlock Text="更容易前期见到" Style="{StaticResource SectionHeaderStyle}"/>
                                            <ItemsControl ItemsSource="{Binding EarlyRelics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text}" Margin="0 2 0 2" Foreground="#444" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="12 0 0 0">
                                            <TextBlock Text="整体更可能出现" Style="{StaticResource SectionHeaderStyle}"/>
                                            <ItemsControl ItemsSource="{Binding SeenRelics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Text}" Margin="0 2 0 2" Foreground="#444" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0 12 0 0"
                                                Visibility="{Binding HasSamples, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="前期样本序列" Style="{StaticResource SectionHeaderStyle}"/>
                                        <ItemsControl ItemsSource="{Binding SampleLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Margin="0 2 0 2" Foreground="#666" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0 0 0 16">
            <StackPanel>
                <TextBlock Text="事件概率预览" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0 0 0 12"/>
                <TextBlock Text="{Binding SeedAnalysisEventVisibilitySummary}" Foreground="#666" TextWrapping="Wrap" Margin="0 0 0 12"/>

                <ItemsControl ItemsSource="{Binding SeedAnalysisEventVisibilityProfiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpandedByDefault, Mode=OneWay}" Margin="0 0 0 12">
                                <StackPanel Margin="0 8 0 0">
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="#666"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <ItemsControl ItemsSource="{Binding ActSummaries}" Margin="0 8 0 0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Margin="0 2 0 2" Foreground="#555" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid Margin="0 12 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0 0 12 0">
                                            <TextBlock Text="更容易前期见到" Style="{StaticResource SectionHeaderStyle}"/>
                                            <ItemsControl ItemsSource="{Binding EarlyEvents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0 2 0 6">
                                                            <TextBlock Style="{StaticResource EventNameStyle}">
                                                                <Run Text="{Binding RankText, Mode=OneWay}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                                                <TextBlock.ToolTip>
                                                                    <ToolTip Style="{StaticResource EventTooltipStyle}"
                                                                             Visibility="{Binding HasTooltipContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <StackPanel MaxWidth="420">
                                                                            <TextBlock Text="{Binding Description}"
                                                                                       TextWrapping="Wrap"
                                                                                       Foreground="#3E2B00"
                                                                                       Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <Border Height="1"
                                                                                    Margin="0 8 0 8"
                                                                                    Background="#C8A24A"
                                                                                    Visibility="{Binding HasDescriptionAndOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <StackPanel Visibility="{Binding HasOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <TextBlock Text="可选项" FontWeight="SemiBold" Margin="0 0 0 6" Foreground="#6D4900"/>
                                                                                <ItemsControl ItemsSource="{Binding Options}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Padding="0 0 0 8">
                                                                                                <StackPanel>
                                                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3E2B00" TextWrapping="Wrap"/>
                                                                                                    <TextBlock Text="{Binding Description}"
                                                                                                               Margin="0 2 0 0"
                                                                                                               TextWrapping="Wrap"
                                                                                                               Foreground="#3E2B00"
                                                                                                               Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding MetricsText}" Margin="20 2 0 0" Foreground="#666" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="12 0 0 0">
                                            <TextBlock Text="整体更可能出现" Style="{StaticResource SectionHeaderStyle}"/>
                                            <ItemsControl ItemsSource="{Binding SeenEvents}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0 2 0 6">
                                                            <TextBlock Style="{StaticResource EventNameStyle}">
                                                                <Run Text="{Binding RankText, Mode=OneWay}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                                                <TextBlock.ToolTip>
                                                                    <ToolTip Style="{StaticResource EventTooltipStyle}"
                                                                             Visibility="{Binding HasTooltipContent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <StackPanel MaxWidth="420">
                                                                            <TextBlock Text="{Binding Description}"
                                                                                       TextWrapping="Wrap"
                                                                                       Foreground="#3E2B00"
                                                                                       Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <Border Height="1"
                                                                                    Margin="0 8 0 8"
                                                                                    Background="#C8A24A"
                                                                                    Visibility="{Binding HasDescriptionAndOptions, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                            <StackPanel Visibility="{Binding HasOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <TextBlock Text="可选项" FontWeight="SemiBold" Margin="0 0 0 6" Foreground="#6D4900"/>
                                                                                <ItemsControl ItemsSource="{Binding Options}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Border Padding="0 0 0 8">
                                                                                                <StackPanel>
                                                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#3E2B00" TextWrapping="Wrap"/>
                                                                                                    <TextBlock Text="{Binding Description}"
                                                                                                               Margin="0 2 0 0"
                                                                                                               TextWrapping="Wrap"
                                                                                                               Foreground="#3E2B00"
                                                                                                               Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </ToolTip>
                                                                </TextBlock.ToolTip>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding MetricsText}" Margin="20 2 0 0" Foreground="#666" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0 12 0 0"
                                                Visibility="{Binding HasSamples, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="前期样本序列" Style="{StaticResource SectionHeaderStyle}"/>
                                        <ItemsControl ItemsSource="{Binding SampleLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Margin="0 2 0 2" Foreground="#666" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0 0 0 16">
            <StackPanel>
                <TextBlock Text="精确路线分析" FontSize="16" FontWeight="SemiBold" Foreground="#333" Margin="0 0 0 12"/>
                <TextBlock Text="这部分不走概率采样，而是按真实地图路线逐条推进，反查目标事件或遗物能通过哪些路线命中。"
                           Foreground="#666"
                           TextWrapping="Wrap"
                           Margin="0 0 0 12"/>

                <Grid Margin="0 0 0 12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0 0 12 0">
                        <TextBlock Text="目标事件" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <TextBox Text="{Binding SeedAnalysisRouteEventCatalogFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"
                                 Margin="0 0 0 6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.85*"/>
                                <ColumnDefinition Width="1.45*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding SeedAnalysisRouteEventActOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedSeedAnalysisRouteEventActOption}"
                                      MinHeight="25"
                                      Margin="0 0 8 0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SeedAnalysisRouteEventCatalogView}"
                                      DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedSeedAnalysisRouteEventCatalogItem}"
                                      MinHeight="25"
                                      Margin="0 0 8 0"/>
                            <Button Grid.Column="2"
                                    Content="添加"
                                    Command="{Binding AddSeedAnalysisRouteEventTargetCommand}"
                                    MinWidth="64"
                                    Padding="12 4"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SeedAnalysisRouteEventTargetChips}" Margin="0 8 0 0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFF3CD"
                                            BorderBrush="#D9A441"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="10 4"
                                            Margin="0 0 8 8">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Display}" Foreground="#6D4900" VerticalAlignment="Center"/>
                                            <Button Content="×"
                                                    Command="{Binding DataContext.RemoveSeedAnalysisRouteEventTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Margin="8 0 0 0"
                                                    Padding="0"
                                                    Width="18"
                                                    Height="18"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#8A5A00"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12 0 0 0">
                        <TextBlock Text="目标遗物" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <TextBox Text="{Binding SeedAnalysisRouteRelicCatalogFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Height="30"
                                 Margin="0 0 0 6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.85*"/>
                                <ColumnDefinition Width="1.45*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding SeedAnalysisRouteRelicActOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedSeedAnalysisRouteRelicActOption}"
                                      MinHeight="25"
                                      Margin="0 0 8 0"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SeedAnalysisRouteRelicCatalogView}"
                                      DisplayMemberPath="Display"
                                      SelectedItem="{Binding SelectedSeedAnalysisRouteRelicCatalogItem}"
                                      MinHeight="25"
                                      Margin="0 0 8 0"/>
                            <Button Grid.Column="2"
                                    Content="添加"
                                    Command="{Binding AddSeedAnalysisRouteRelicTargetCommand}"
                                    MinWidth="64"
                                    Padding="12 4"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SeedAnalysisRouteRelicTargetChips}" Margin="0 8 0 0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F1FB"
                                            BorderBrush="#8CB5E2"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            Padding="10 4"
                                            Margin="0 0 8 8">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Display}" Foreground="#315B86" VerticalAlignment="Center"/>
                                            <Button Content="×"
                                                    Command="{Binding DataContext.RemoveSeedAnalysisRouteRelicTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Margin="8 0 0 0"
                                                    Padding="0"
                                                    Width="18"
                                                    Height="18"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#315B86"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <Grid Margin="0 0 0 12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="0.95*"/>
                        <ColumnDefinition Width="0.95*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0 0 12 0">
                        <TextBlock Text="最多返回路线数" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <TextBox Text="{Binding SeedAnalysisRouteMaxResultsText, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0 0 12 0">
                        <TextBlock Text="最多检查路线组合" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <TextBox Text="{Binding SeedAnalysisRouteMaxChecksText, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0 0 12 0">
                        <TextBlock Text="商店策略" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <ComboBox ItemsSource="{Binding SeedAnalysisRouteShopStrategyOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedSeedAnalysisRouteShopStrategyOption}"
                                  MinHeight="25"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0 0 12 0">
                        <TextBlock Text="路线偏好" FontSize="12" Foreground="#666" Margin="0 0 0 6"/>
                        <ComboBox ItemsSource="{Binding SeedAnalysisRoutePreferenceOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedItem="{Binding SelectedSeedAnalysisRoutePreferenceOption}"
                                  MinHeight="25"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <Button Content="搜索路线"
                                Command="{Binding AnalyzeSeedRoutesCommand}"
                                Style="{StaticResource ButtonPrimary}"
                                Padding="20 6"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding SeedAnalysisRouteSummary}" Foreground="#333" TextWrapping="Wrap" Margin="0 0 0 12"/>

                <ItemsControl ItemsSource="{Binding SeedAnalysisRouteMatches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpandedByDefault, Mode=OneWay}" Margin="0 0 0 12">
                                <StackPanel Margin="0 8 0 0">
                                    <Border Background="#FFF8E1"
                                            BorderBrush="#E6C76E"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0 0 0 10">
                                        <TextBlock Text="{Binding HitSummary}" Foreground="#6D4900" TextWrapping="Wrap"/>
                                    </Border>

                                    <TabControl ItemsSource="{Binding Acts}"
                                                Margin="0 0 0 8"
                                                Style="{StaticResource RouteTabControlStyle}">
                                        <TabControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </TabControl.ItemTemplate>
                                        <TabControl.ItemContainerStyle>
                                            <Style TargetType="TabItem" BasedOn="{StaticResource RouteTabItemStyle}"/>
                                        </TabControl.ItemContainerStyle>
                                        <TabControl.ContentTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0 10 0 0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.35*"/>
                                                        <ColumnDefinition Width="0.95*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Padding="12"
                                                            BorderBrush="#E8E8E8"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Background="#FCFCFC"
                                                            Margin="0 0 12 0">
                                                        <StackPanel>
                                                            <DockPanel Margin="0 0 0 10">
                                                                <TextBlock Text="地图"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#333"
                                                                           DockPanel.Dock="Left"/>
                                                                <TextBlock Text="{Binding AncientSummary}"
                                                                           Foreground="#8A5A00"
                                                                           TextWrapping="Wrap"
                                                                           HorizontalAlignment="Right"
                                                                           Visibility="{Binding HasAncientSummary, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </DockPanel>

                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          MinHeight="420"
                                                                          PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                                                                <Canvas Width="{Binding MapWidth}" Height="{Binding MapHeight}">
                                                                    <ItemsControl ItemsSource="{Binding MapLinks}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <Canvas/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <shapes:Line X1="{Binding X1}"
                                                                                             Y1="{Binding Y1}"
                                                                                             X2="{Binding X2}"
                                                                                             Y2="{Binding Y2}"
                                                                                             Stroke="{Binding Stroke}"
                                                                                             StrokeThickness="{Binding StrokeThickness}"
                                                                                             StrokeStartLineCap="Round"
                                                                                             StrokeEndLineCap="Round"/>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <ItemsControl ItemsSource="{Binding MapNodes}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <Canvas/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemContainerStyle>
                                                                            <Style TargetType="ContentPresenter">
                                                                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                                                            </Style>
                                                                        </ItemsControl.ItemContainerStyle>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid Width="{Binding Size}" Height="{Binding Size}">
                                                                                    <Ellipse Fill="{Binding Fill}"
                                                                                             Stroke="{Binding Stroke}"
                                                                                             StrokeThickness="2"/>
                                                                                    <TextBlock Text="{Binding Label}"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="#333"/>
                                                                                    <Grid.ToolTip>
                                                                                        <ToolTip>
                                                                                            <StackPanel MaxWidth="320">
                                                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                                                <TextBlock Text="{Binding Detail}"
                                                                                                           Margin="0 4 0 0"
                                                                                                           TextWrapping="Wrap"
                                                                                                           Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                            </StackPanel>
                                                                                        </ToolTip>
                                                                                    </Grid.ToolTip>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Canvas>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Grid.Column="1"
                                                            Padding="12"
                                                            BorderBrush="#E8E8E8"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Background="#FFFFFF">
                                                        <StackPanel>
                                                            <DockPanel Margin="0 0 0 10">
                                                                <TextBlock Text="层数信息"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#333"
                                                                           DockPanel.Dock="Left"/>
                                                                <TextBlock Text="{Binding Rooms.Count, StringFormat=共 {0} 个节点}"
                                                                           Foreground="#888"
                                                                           FontSize="12"
                                                                           HorizontalAlignment="Right"/>
                                                            </DockPanel>
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                          MinHeight="420"
                                                                          PreviewMouseWheel="InnerScrollViewer_PreviewMouseWheel">
                                                                <ItemsControl ItemsSource="{Binding Rooms}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border>
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border" BasedOn="{StaticResource RouteSideCardStyle}">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                                                                                <Setter Property="Background" Value="#FFF3CD"/>
                                                                                                <Setter Property="BorderBrush" Value="#D9A441"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <StackPanel>
                                                                                    <DockPanel>
                                                                                        <Border Background="#EFEFEF"
                                                                                                CornerRadius="10"
                                                                                                Padding="8 2"
                                                                                                DockPanel.Dock="Left"
                                                                                                Margin="0 0 8 0">
                                                                                            <TextBlock Text="{Binding Row, StringFormat=第 {0} 层}"
                                                                                                       Foreground="#555"
                                                                                                       FontSize="11"
                                                                                                       FontWeight="SemiBold"/>
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding Summary}"
                                                                                                   Foreground="#333"
                                                                                                   TextWrapping="Wrap"
                                                                                                   VerticalAlignment="Center"/>
                                                                                    </DockPanel>
                                                                                    <TextBlock Text="{Binding Detail}"
                                                                                               Margin="0 4 0 0"
                                                                                               Foreground="#666"
                                                                                               TextWrapping="Wrap"
                                                                                               Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </TabControl.ContentTemplate>
                                    </TabControl>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

